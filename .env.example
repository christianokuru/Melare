# ── App ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com          # production URL (https enables HSTS + upgrade-insecure-requests)

# ── Database (Neon) ────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/melare?sslmode=require

# ── Auth (Better Auth) ─────────────────────────────
BETTER_AUTH_SECRET=                                  # openssl rand -base64 32
BETTER_AUTH_URL=https://your-domain.com
ADMIN_EMAIL=                                         # the ONE admin; must sign up and verify this email
GOOGLE_CLIENT_ID=                                    # optional Google sign-in
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH=0                            # set to 1 when Google keys are configured

# ── Images (Neon Object Storage, public_read bucket) ──
NEON_STORAGE_ENDPOINT=https://br-xxxx.storage.c-8.eu-central-1.aws.neon.tech   # Neon → branch → Object storage
NEON_STORAGE_REGION=eu-central-1
NEON_STORAGE_BUCKET=melare-media
NEON_STORAGE_ACCESS_KEY_ID=nak_live_...                                         # credential with storage:read + storage:write
NEON_STORAGE_SECRET_ACCESS_KEY=nsk_live_...
NEXT_PUBLIC_MEDIA_URL=https://br-xxxx.storage.c-8.eu-central-1.aws.neon.tech/melare-media

# ── Payments (Flutterwave, NGN + USD) ──────────────
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=                                    # "Secret hash" set in Flutterwave → Settings → Webhooks

# ── Email (Resend) ─────────────────────────────────
RESEND_API_KEY=                                      # without it, emails are logged to the server console
EMAIL_FROM="Melaré <hello@your-domain.com>"          # domain must be verified in Resend

# ── Jobs ───────────────────────────────────────────
CRON_SECRET=                                         # openssl rand -hex 24 (Vercel Cron sends it automatically)

# ── Marketing ──────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000            # international format, digits only
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GA_ID=                                   # GA4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_CLARITY_ID=                              # Microsoft Clarity project ID
NEXT_PUBLIC_META_PIXEL_ID=                           # optional Meta Pixel ID
